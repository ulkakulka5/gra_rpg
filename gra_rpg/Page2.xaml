<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gra_rpg.Page2"
             Title="Page2">
    <Grid WidthRequest="1280" HeightRequest="832" x:Name="MainGrid" >


        <Image Source="page2_bg.png"  WidthRequest="1280" HeightRequest="832"/>
        <Image x:Name="rozia"
           Source="rozia_walk.png"
           WidthRequest="150"
           HorizontalOptions="Start"
           VerticalOptions="Start"/>

        <Border x:Name="ChestCode"
           IsVisible="False"
           BackgroundColor="RosyBrown"
           Padding="20"
           WidthRequest="300"
           HorizontalOptions="Center"
           VerticalOptions="Center">

            <VerticalStackLayout Spacing="10">

                <Label Text="Wpisz kod"
                   TextColor="SaddleBrown"
                   HorizontalOptions="Center"/>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Entry x:Name="CodeEntry" />
                    <Image Source="closed.png"
                       x:Name="Closed"
                       WidthRequest="30"
                       HeightRequest="30"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       IsVisible="False"/>
                    <Image Source="opened.png"
                       x:Name="Opened"    
                       WidthRequest="30"
                       HeightRequest="30"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       IsVisible="False"/>      

                </HorizontalStackLayout>

                <Button Text="Otwórz"
                    Clicked="OnCodeSubmit"
                    BackgroundColor="ForestGreen"    />

            </VerticalStackLayout>
        </Border>


    </Grid>
</ContentPage>